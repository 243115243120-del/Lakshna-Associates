rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin membership is managed manually in the Firebase console.
    // No browser client can create or modify admin records.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Public website visitors can submit enquiries.
    // Only authenticated admins can read/update them.
    match /queries/{queryId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'email',
          'projectType',
          'service',
          'location',
          'message',
          'status',
          'submittedAt',
          'replies'
        ])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.projectType is string
        && request.resource.data['service'] is string
        && request.resource.data.location is string
        && request.resource.data.message is string
        && request.resource.data.status == 'new';

      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}